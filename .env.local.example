NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_. Required for
# /admin/users to invite accounts. Supabase dashboard -> Project Settings ->
# API -> service_role key. Add this to Vercel's project env vars too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute base URL used to build invite and password-reset links, which are
# sent by email and so cannot be relative. In production set this to the real
# domain (https://hseportal.hs-experts.com); locally http://localhost:3000.
# Whatever you set must also appear in the Supabase dashboard under
# Authentication -> URL Configuration -> Redirect URLs, or Supabase discards
# it and falls back to the project's Site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the "Continue with Microsoft" button. Left unset (so, off) because
# Microsoft sign-in needs an Azure app registration that does not exist yet, and
# a sign-in button that cannot succeed for anybody is worse than no button.
# Google is unaffected and always offered.
#
# Set this to exactly "true" once docs/ENABLE-SSO-STEPS.md Part B is done. It is
# inlined at build time, so it needs a rebuild and redeploy, not just a restart.
# NEXT_PUBLIC_ENABLE_MICROSOFT_SIGNIN=true

# Direct Postgres connection string, used only by the scripts/ gates — the app
# itself never reads it. Around 105 scripts under scripts/ open a `pg` client
# with it, 58 of them check-*/diagnose-* gates (see
# scripts/check-handover-chain-live.mjs). Without it they print
# "SKIP: no SUPABASE_DB_URL" and `npm run test:db` still exits 0, so a green
# run without this variable proves structure only, not live behaviour.
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# URI. Use the direct (port 5432) URI, not the transaction pooler on 6543:
# the gates run session-level SQL. The scripts connect with
# ssl: { rejectUnauthorized: false }, so no sslmode parameter is needed.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Set this to exactly "true" only after passkeys are enabled in the Supabase
# dashboard (Authentication -> Sign In / Providers). Like the Microsoft flag it
# is inlined at build time, so it needs a rebuild and redeploy.
#
# While it is unset, BiometricSignIn renders null without touching the network.
# That is deliberate: its server probe is a cross-origin GET to
# /auth/v1/settings that otherwise ran on every sign-in page load to be told
# passkeys_enabled=false, and it logged a console error whenever Supabase was
# unreachable — which is how it showed up as the first finding in
# audit-runtime-errors.json against a local stack that was not running.
# NEXT_PUBLIC_ENABLE_PASSKEYS=true
