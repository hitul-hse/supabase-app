# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# secrets (never commit)
.secrets/

.vercel
.env*

# personal Claude Code settings (shared config lives in .claude/settings.json)
.claude/settings.local.json

# transient e2e scratch dir
scripts/_e2e_tmp/

# Playwright verification output
test-results/

# API discovery output (scripts/discover). Vendor payloads contain real names,
# emails, contract and salary data — inventories are for local review, never the
# repo. The inventory redacts PII from its reports, but the raw .json alongside
# them is not redacted, so the whole directory stays out.
docs/discovery/

# The real build, parked here by scripts/check-time-acceptance.mjs while it
# builds against a stub (NEXT_PUBLIC_* are compile-time, so the app must be
# rebuilt to point elsewhere). Restored on every exit path, but if a run is
# killed mid-flight this directory holds the real build. Never commit it.
.next-real/

# Build output for scripts/check-server-action-auth.mjs, which builds against a
# stub Supabase in its own distDir so the shared .next is never disturbed.
.next-action-probe/
.next-acceptance/

# Throwaway scratch scripts. Debugging a live API or a browser flow means
# writing one-off probes, and PowerShell mangles inline quoting badly enough
# that a file is the only reliable route — so they get created constantly.
# Untracked they still reach eslint (a bare require() is an error under the
# app's ESM rule), so a stray scratch file fails `npm run lint` for everyone
# with a problem in code that is not part of the app. Ignored by prefix so
# cleaning up late costs nothing.
/tmp-*
.tmp-*

# OAuth success-path probe build (scripts/check-oauth-success-path.mjs)
.next-oauth-probe/

# Probe builds for the OAuth flake/order investigations, same pattern as above.
.next-flake-probe/
.next-order-probe/

# Dashboard row-reachability gate (scripts/check-dashboard-tables.mjs). Its own
# distDir so it never touches .next, which parallel agent sessions serve from.
.next-tables/

# Editor-local state: the active plan, scratch scripts, and a mirror of the
# third-party agent skills from .claude/skills (V3Code's loader scans this
# directory and does not follow the .claude ones). Machine-specific, ~150 files
# of somebody else's code, and regenerable with .v3code/sync-claude-skills.ps1.
.v3code/
.claude/settings.json.graphify-bak  
