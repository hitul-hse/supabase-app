NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_. Required for
# /admin/users to invite accounts. Supabase dashboard -> Project Settings ->
# API -> service_role key. Add this to Vercel's project env vars too.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Absolute base URL used to build invite and password-reset links, which are
# sent by email and so cannot be relative. In production set this to the real
# domain (https://hseportal.hs-experts.com); locally http://localhost:3000.
# Whatever you set must also appear in the Supabase dashboard under
# Authentication -> URL Configuration -> Redirect URLs, or Supabase discards
# it and falls back to the project's Site URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
